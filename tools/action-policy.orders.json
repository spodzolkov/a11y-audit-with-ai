{
  "module": "orders",
  "description": "Allowlist/denylist модуля orders (Обмін валют). Змінює людина в режимі обслуговування. Вихід за межі модуля після кліку crawler фіксує в outOfModule і повертається назад.",
  "allow": [
    { "role": "button", "name": "Архів", "class": "safe", "reason": "перемикання на архів заявок у межах модуля (аудит 2026-11-04: стани Архів > Дата)" },
    { "role": "button", "name": "Автоматичний продаж", "class": "safe", "reason": "перегляд договорів автопродажу; створення - окремі кнопки" },
    { "role": "button", "name": "Купівля", "class": "safe", "reason": "віджет курсів: перемикання типу курсу" },
    { "role": "button", "name": "Продаж", "class": "safe", "reason": "віджет курсів: перемикання типу курсу" },
    { "role": "button", "name": "НБУ", "class": "safe", "reason": "віджет курсів: перемикання на курс НБУ" },
    { "role": "button", "namePattern": "^Delta icon ", "class": "safe", "reason": "віджет курсів: розгортання рядка валюти" },
    { "role": "button", "name": "Дата", "class": "safe", "reason": "сортування журналу заявок" },
    { "role": "button", "name": "Підстава", "class": "safe", "reason": "сортування журналу заявок" },
    { "role": "button", "name": "Списано", "class": "safe", "reason": "сортування журналу заявок" },
    { "role": "button", "name": "Курс", "class": "safe", "reason": "сортування журналу заявок" },
    { "role": "button", "name": "Зараховано", "class": "safe", "reason": "сортування журналу заявок" },
    { "role": "button", "name": "Статус", "class": "safe", "reason": "сортування журналу заявок" },
    { "role": "button", "name": "Реквізити", "class": "safe", "reason": "перегляд реквізитів (лише читання)" }
  ],
  "deny": [
    { "role": "button", "name": "Вийти з акаунту", "reason": "завершує сесію" },
    { "role": "button", "name": "Переключити мову інтерфейсу на англійську", "reason": "змінює налаштування профілю" },
    { "role": "button", "name": "Змінити тему оформлення", "reason": "змінює налаштування профілю" },
    { "role": "button", "name": "Налаштування", "reason": "може змінювати налаштування профілю/модуля" },
    { "role": "button", "name": "Залишити відгук", "reason": "форма відправки відгуку" }
  ]
}
