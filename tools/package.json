{
  "name": "a11y-pipeline-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Допоміжні інструменти пайплайну a11y-audit-pipeline: стан і журнал, перевірка авторизації, runtime-сканери. Лише читання цілі аудиту; запис тільки в output/ і result_history/.",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "state": "node pipeline-state.mjs",
    "auth:login": "node auth-login.mjs",
    "auth:check": "node auth-check.mjs",
    "axe": "node axe-run.mjs",
    "lh": "node lh-run.mjs",
    "crawl": "node popup-crawler.mjs"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "lighthouse": "13.6.0",
    "playwright": "1.62.0",
    "puppeteer-core": "25.16.0"
  }
}
